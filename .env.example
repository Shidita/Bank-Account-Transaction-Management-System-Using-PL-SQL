# Copy this file to ".env" and fill in your Oracle login.
# Leave ORACLE_* empty (or set BANK_MODE=demo) to run in demo mode without Oracle.
ORACLE_USER=system
ORACLE_PASSWORD=your_password
# Easy Connect string:  host:port/service_name
#   Oracle XE 11g :  localhost:1521/XE
#   Oracle XE 18c/21c:  localhost:1521/XEPDB1
ORACLE_DSN=localhost:1521/XE
# BANK_MODE=demo
PORT=5000
